        given-names: Esley
      - family-names: Pinto-Cámara
        given-names: Raúl
      - family-names: Linares
        given-names: Alejandro
      - name: "et al."
    journal: "Nature Communications"
    volume: 13
    start: 7452
    year: 2022
    doi: "10.1038/s41467-022-34693-9"
